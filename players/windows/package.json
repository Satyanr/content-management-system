{
  "name": "cms-signage-player",
  "version": "1.0.1",
  "description": "Windows digital signage player for CMS Player API v1",
  "author": "CMS Digital Signage",
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "prepare:shared": "node scripts/prepare-shared.js",
    "prestart": "npm run prepare:shared",
    "start": "electron .",
    "pretest": "npm run prepare:shared",
    "test": "node --test tests/*.test.js",
    "test:e2e": "npm run prepare:shared && playwright test",
    "dist": "npm run prepare:shared && electron-builder --win nsis --x64 --publish never",
    "pack": "npm run prepare:shared && electron-builder --dir --win --x64 --publish never"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "id.cms.signage.player",
    "productName": "CMS Signage Player",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CMS-Signage-Player-${version}-x64-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
