{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cms:player-api:manifest:v1",
  "title": "Player manifest v1",
  "type": "object",
  "required": ["schemaVersion", "revision", "serverTimeUtc", "state", "device", "output", "currentSchedule", "currentPlaylistId", "nextTransitionUtc", "planStartUtc", "validUntilUtc", "schedulePlan", "playlists", "media", "pollIntervalSeconds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "serverTimeUtc": {"$ref": "#/$defs/time"},
    "state": {"enum": ["scheduled", "no_schedule"]},
    "device": {
      "type": "object", "required": ["publicId", "name", "platform", "playerVersion", "capabilities"],
      "properties": {
        "publicId": {"type": "string", "format": "uuid"}, "name": {"type": "string"},
        "platform": {"enum": ["windows", "android", "linux", "other"]}, "playerVersion": {"type": ["string", "null"]},
        "capabilities": {"type": "object", "required": ["reported", "mediaTypes"], "properties": {"reported": {"const": false}, "mediaTypes": {"type": "array", "items": {"enum": ["image", "video"]}}}}
      }
    },
    "output": {"type": "object", "required": ["width", "height", "orientation"], "properties": {"width": {"type": ["integer", "null"], "minimum": 1}, "height": {"type": ["integer", "null"], "minimum": 1}, "orientation": {"enum": ["landscape", "portrait"]}}},
    "currentSchedule": {"anyOf": [{"$ref": "#/$defs/schedule"}, {"type": "null"}]},
    "currentPlaylistId": {"type": ["integer", "null"]},
    "nextTransitionUtc": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "planStartUtc": {"$ref": "#/$defs/time"}, "validUntilUtc": {"$ref": "#/$defs/time"},
    "schedulePlan": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["startUtc", "endUtc", "state", "schedule"], "properties": {"startUtc": {"$ref": "#/$defs/time"}, "endUtc": {"$ref": "#/$defs/time"}, "state": {"enum": ["scheduled", "no_schedule"]}, "schedule": {"anyOf": [{"$ref": "#/$defs/schedule"}, {"type": "null"}]}}}},
    "playlists": {"type": "array", "items": {"$ref": "#/$defs/playlist"}},
    "media": {"type": "array", "items": {"$ref": "#/$defs/media"}},
    "pollIntervalSeconds": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "time": {"type": "string", "format": "date-time"},
    "schedule": {
      "type": "object", "required": ["id", "playlistId", "name", "priority", "type", "timezone", "startsAtUtc", "endsAtUtc", "startDate", "endDate", "startTime", "endTime", "weekdays"],
      "properties": {
        "id": {"type": "integer"}, "playlistId": {"type": "integer"}, "name": {"type": "string"}, "priority": {"type": "integer"}, "type": {"enum": ["once", "weekly"]}, "timezone": {"type": "string"},
        "startsAtUtc": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]}, "endsAtUtc": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "startDate": {"type": ["string", "null"]}, "endDate": {"type": ["string", "null"]}, "startTime": {"type": ["string", "null"]}, "endTime": {"type": ["string", "null"]}, "weekdays": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 1, "maximum": 7}}
      }
    },
    "playlist": {
      "type": "object", "required": ["id", "name", "width", "height", "background", "totalDuration", "pages"],
      "properties": {
        "id": {"type": "integer"}, "name": {"type": "string"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "background": {"type": "string"}, "totalDuration": {"type": "integer"},
        "pages": {"type": "array", "items": {"type": "object", "required": ["id", "name", "sort_order", "duration", "background", "zones"], "properties": {
          "id": {"type": "integer"}, "name": {"type": "string"}, "sort_order": {"type": "integer"}, "duration": {"type": "integer", "minimum": 1}, "background": {"type": "string"},
          "zones": {"type": "array", "items": {"type": "object", "required": ["id", "name", "x", "y", "width", "height", "z_index", "visible", "fit_mode", "keep_aspect_ratio", "items"], "properties": {
            "id": {"type": "integer"}, "name": {"type": "string"}, "x": {"type": "integer"}, "y": {"type": "integer"}, "width": {"type": "integer"}, "height": {"type": "integer"}, "z_index": {"type": "integer"}, "visible": {"type": "boolean"}, "keep_aspect_ratio": {"type": "boolean"}, "fit_mode": {"enum": ["contain", "cover", "stretch"]}, "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
          }}}
        }}}
      }
    },
    "item": {
      "type": "object", "required": ["id", "sort_order", "mediaId", "title", "type", "duration", "durationMode", "knownDuration", "available"],
      "properties": {
        "id": {"type": "integer"}, "sort_order": {"type": "integer"}, "mediaId": {"type": ["integer", "null"]}, "title": {"type": "string"}, "type": {"enum": ["image", "video", null]}, "duration": {"type": ["integer", "null"], "minimum": 1}, "durationMode": {"enum": ["auto", "manual"]}, "knownDuration": {"type": ["number", "null"], "exclusiveMinimum": 0}, "available": {"type": "boolean"}
      }
    },
    "media": {
      "type": "object", "required": ["id", "type", "mimeType", "size", "checksum", "available", "downloadUrl"],
      "properties": {
        "id": {"type": "integer"}, "type": {"enum": ["image", "video"]}, "mimeType": {"type": "string"}, "size": {"type": ["integer", "null"], "minimum": 0}, "available": {"type": "boolean"}, "downloadUrl": {"type": "string", "pattern": "^/api/device/media/[0-9]+$"},
        "checksum": {"anyOf": [{"type": "object", "required": ["algorithm", "value"], "properties": {"algorithm": {"const": "sha256"}, "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, {"type": "null"}]}
      }
    }
  }
}
